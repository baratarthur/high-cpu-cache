component provides libs.utils.Lab requires repositories.posts.PostsRepository, util.Random random {
    Post[] Lab:shuffle(Post state[]) {
        Post newStateInRandomOrder[] = new Post[state.arrayLength]
        newStateInRandomOrder =[] state
        int stateSize = newStateInRandomOrder.arrayLength
        random.setSeed(42)

        for(int i = 0; i < stateSize; i++) {
            int randomTargetIndex = random.getInt(stateSize)
            Post aux = newStateInRandomOrder[randomTargetIndex]
            newStateInRandomOrder[randomTargetIndex] = newStateInRandomOrder[i]
            newStateInRandomOrder[i] = aux
        }

        return newStateInRandomOrder
    }

    Post[] Lab:bubbleSort(Post state[]) {
        Post newStateInOrderById[] =new Post[state.arrayLength]
        newStateInOrderById =[] state
        int stateSize = newStateInOrderById.arrayLength
        for(int i = 0; i < stateSize; i++) {
            for(int j = 0; j < (stateSize - i); j++) {
                if(newStateInOrderById[j].id > newStateInOrderById[i].id) {
                    Post aux = newStateInOrderById[j]
                    newStateInOrderById[j] = newStateInOrderById[i]
                    newStateInOrderById[i] = aux
                }
            }
        }

        return newStateInOrderById
    }
}
