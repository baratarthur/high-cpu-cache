component provides libs.utils.PostsUtils requires repositories.posts.PostsRepository, data.mysql.MySQL, time.Calendar ic,
data.IntUtil iu, time.TimeUnix timeUnix, libs.utils.Logger logger, data.json.JSONEncoder je, util.Math math, libs.krabs.LatencyStore ls,
data.DecUtil du {
    Post[] PostsUtils:accumulate(Post existingPosts[], Post newPosts[]) {
        return new Post[](existingPosts, newPosts)
    }

    Post PostsUtils:getPostFromMYSQLRow(MySQLRow row) {
        int id
        int userId
        int likes
        char content[]
        DateTime ttl = ic.getTime()
        DateTime createdAt

        for(int i = 0; i < row.fields.arrayLength; i++) {
            if ( row.fields[i].name == "id") {
                id = iu.intFromString(row.fields[i].value)
            } else if (row.fields[i].name == "userId") {
                userId = iu.intFromString(row.fields[i].value)
            } else if (row.fields[i].name == "likes") {
                likes = iu.intFromString(row.fields[i].value)
            } else if (row.fields[i].name == "content") {
                content = row.fields[i].value
            } else if (row.fields[i].name == "created_at") {
                int timeInMs = iu.intFromString(row.fields[i].value)
                createdAt = timeUnix.fromUnixTime(timeInMs)
            }
        }

        return new Post(id=id, userId=userId, likes=likes, content=content, ttl=ttl, createdAt=createdAt)
    }

    Post[] PostsUtils:calculateHalfLifeWeight(Post inCache[]){
        Post cacheCopy[] = new Post[inCache.arrayLength]

        for(int i = 0; i < cacheCopy.arrayLength; i++) {
            cacheCopy[i] = new Post(id=inCache[i].id, userId=inCache[i].userId, content=inCache[i].content, likes=inCache[i].likes, ttl=inCache[i].ttl, weight=getWeight(inCache[i].createdAt), createdAt=inCache[i].createdAt)
        }

        // logger.storeInfo("Weighted posts: $(je.jsonFromArray(cacheCopy))")

        return cacheCopy
    }

    const int halfLife = 60*60*1000

    dec getWeight(DateTime time) {
        int milisecondsSinceCreated = ls.getMilisecondsExecutionTimeSince(time)
        dec power = (milisecondsSinceCreated*1.0) / (halfLife*1.0)
        logger.storeInfo("half life: $(iu.makeString(halfLife)) | power: $(du.makeString(power, 4)) | millis: $(iu.makeString(milisecondsSinceCreated))")
        return 100 / math.power(2.0, power)
    }

}