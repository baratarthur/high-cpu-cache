uses time.DateUtil
uses libs.krabs.MetricsStore

data Post {
    int id
    int userId
    int likes
    dec weight
    char content[]
    DateTime ttl // Time to live in miliseconds, for cache eviction
    DateTime createdAt
}

interface PostsRepository {
    void addPosts(store Post newPosts[])
    Post getPostById(store int postId)
    Post[] getUserFeed(store int userId)
    Post[] getPosts(char start[], char amount[])
}
