uses repositories.posts.PostsRepository
uses data.mysql.MySQL

interface PostsUtils {
    Post[] accumulate(Post existing[], Post newPosts[])
    Post getPostFromMYSQLRow(MySQLRow row)
    Post[] calculateHalfLifeWeight(Post inCache[])
    Post[] getFeedFromCached(Post posts[]) {
        return dana.sub(posts, 0, 4)
    }
}
